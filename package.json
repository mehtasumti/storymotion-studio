{
  "name": "storymotion-studio",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Free, client-side storyboard, prompt and animated still-image video maker with a static landing page. No paid APIs, no backend.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:cf": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "python3 e2e/smoke.py http://127.0.0.1:8787"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.525.0",
    "mediabunny": "^1.61.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
