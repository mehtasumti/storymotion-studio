# Copy to .env for local builds, or set the same names as build variables in Cloudflare
# (Workers & Pages → storymotion-studio → Settings → Build → Variables and secrets).
# Leave a value empty to switch that feature off. All values end up in public HTML: no secrets.

# Public origin, no trailing slash (canonical URLs, Open Graph, robots.txt, sitemap.xml)
SITE_URL=https://storymotion-studio.sumti-mehta-01.workers.dev

# Your Google Form link, e.g. https://forms.gle/AbCdEf123 (enables "Send feedback" buttons)
FEEDBACK_FORM_URL=

# Cloudflare Web Analytics site token: the 32-character value in data-cf-beacon='{"token": "…"}'
CF_ANALYTICS_TOKEN=

# Optional contact e-mail for the privacy notice and terms
CONTACT_EMAIL=
